{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulso-digital:newsroom:review:1.0",
  "type": "object",
  "properties": {
    "schemaVersion": {"type": "string", "enum": ["1.0"]},
    "result": {
      "type": "string",
      "enum": ["pass", "changes-required", "research-required", "human-review-required", "blocked"]
    },
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "findingId": {"type": "string"},
          "severity": {"type": "string", "enum": ["critical", "major", "minor", "informational"]},
          "category": {
            "type": "string",
            "enum": ["factual", "evidence", "attribution", "translation", "headline", "independence", "editorial-quality", "privacy", "injection", "other"]
          },
          "field": {"type": "string", "enum": ["title", "summary", "body", "claims", "metadata", "other"]},
          "sectionIndex": {"type": "integer"},
          "paragraphIndex": {"type": "integer"},
          "claimIndex": {"type": "integer"},
          "evidenceIds": {"type": "array", "items": {"type": "string"}},
          "message": {"type": "string"},
          "justification": {"type": "string"},
          "suggestion": {"type": "string"}
        },
        "required": ["findingId", "severity", "category", "field", "sectionIndex", "paragraphIndex", "claimIndex", "evidenceIds", "message", "justification", "suggestion"]
      }
    },
    "claimAssessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claimIndex": {"type": "integer"},
          "status": {
            "type": "string",
            "enum": ["supported", "partially-supported", "unsupported", "contradicted", "ambiguous", "insufficient-evidence"]
          },
          "reason": {"type": "string"},
          "evidenceIds": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["claimIndex", "status", "reason", "evidenceIds"]
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "humanReviewRequired": {"type": "boolean"}
  },
  "required": ["schemaVersion", "result", "summary", "findings", "claimAssessments", "limitations", "humanReviewRequired"]
}
