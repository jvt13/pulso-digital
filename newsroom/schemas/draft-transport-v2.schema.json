{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulso-digital:newsroom:draft-transport:2.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "insufficient": {"type": "boolean"},
    "reason": {"type": "string"},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "tags": {"type": "array", "maxItems": 8, "items": {"type": "string"}},
    "sections": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "paragraphs": {"type": "array", "minItems": 0, "maxItems": 4, "items": {"type": "string"}}
        },
        "required": ["title", "paragraphs"]
      }
    },
    "claims": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "s": {"type": "integer", "minimum": 0},
          "p": {"type": "integer", "minimum": 0},
          "nature": {"type": "string", "enum": ["documented-fact", "attributed-statement", "expectation", "rumor", "opinion"]},
          "attribution": {"type": "string"},
          "ev": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "required": ["s", "p", "nature", "attribution", "ev"]
      }
    },
    "titleEvidence": {"type": "array", "items": {"type": "string"}},
    "summaryEvidence": {"type": "array", "items": {"type": "string"}},
    "imageSuggestion": {"type": "string"}
  },
  "required": ["insufficient", "reason", "title", "summary", "tags", "sections", "claims", "titleEvidence", "summaryEvidence", "imageSuggestion"]
}
