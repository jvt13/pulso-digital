[Unit]
Description=PulsoBit editorial orchestrator
Documentation=file:/opt/pulso-digital/current/docs/vps-deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pulso-digital
Group=pulso-digital
UMask=0077
WorkingDirectory=/opt/pulso-digital/current
EnvironmentFile=/etc/pulso-digital/pulso.env
Environment=NODE_ENV=production
Environment=PULSO_DATA_ROOT=/var/lib/pulso-digital
Environment=PULSO_PYTHON_BIN=/opt/pulso-digital/venv/bin/python
ExecStart=/opt/pulso-digital/runtime/node-v24.22.3-linux-x64/bin/node /opt/pulso-digital/current/src/automation/cli.mjs start
Restart=on-failure
RestartSec=30
TimeoutStopSec=45
KillSignal=SIGTERM
StartLimitIntervalSec=300
StartLimitBurst=3
CPUWeight=50
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/pulso-digital
ReadWritePaths=/var/www/pulso-digital
ReadWritePaths=/opt/pulso-digital/current/public
ReadOnlyPaths=/etc/pulso-digital
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pulso-digital

[Install]
WantedBy=multi-user.target
