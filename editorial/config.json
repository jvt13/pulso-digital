{
  "schemaVersion": "1.0",
  "allowSyntheticPublication": false,
  "publicationPolicy": {
    "schemaVersion": "1.0",
    "mode": "manual",
    "autonomousSimulationOnly": true,
    "emergencyPause": false,
    "limits": {
      "maxArticlesPerDay": 3,
      "minIntervalMinutes": 60,
      "maxPerCategoryPerDay": 1,
      "maxContentAgeHours": 168,
      "maxConsecutiveFailures": 3
    }
  },
  "limits": {
    "inputBytes": 262144,
    "stateBytes": 8388608,
    "assetBytes": 5242880,
    "stagedBytes": 52428800,
    "title": 180,
    "summary": 500,
    "paragraph": 6000,
    "body": 80000,
    "sections": 30,
    "paragraphsPerSection": 30,
    "sources": 30,
    "tags": 15,
    "buildTimeoutMs": 30000
  },
  "deduplication": { "titleSimilarity": 0.72, "recommendedSources": 2 }
}
