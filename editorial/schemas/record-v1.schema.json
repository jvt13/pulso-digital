{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulso-digital:editorial:record:1.0",
  "title": "Registro operacional privado — nunca é contrato de importação",
  "type": "object",
  "required": ["recordVersion", "input", "createdAt", "state", "validation", "approval", "receipt", "history"],
  "additionalProperties": false,
  "properties": {
    "recordVersion": {"const": "1.0"},
    "input": {"$ref": "input-v1.schema.json"},
    "createdAt": {"type": "string", "format": "date-time"},
    "state": {"enum": ["pending", "draft", "validated", "approved", "published", "rejected"]},
    "validation": {"type": ["object", "null"], "description": "valid, errors, warnings, checkedAt, contentHash e targetHash"},
    "approval": {"type": ["object", "null"], "description": "reviewer explícito, at, contentHash, factsReviewed, imageRightsReviewed, acknowledgedWarnings e reason"},
    "receipt": {"type": ["object", "null"], "description": "at, slug, operation, publishedAt, approvedHash, publicArticleHash e changed"},
    "history": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sequence", "at", "from", "to", "action", "actor", "reason", "previousHash", "snapshot", "hash"],
        "additionalProperties": false,
        "properties": {
          "sequence": {"type": "integer", "minimum": 1}, "at": {"type": "string", "format": "date-time"},
          "from": {"type": ["string", "null"]}, "to": {"type": "string"},
          "action": {"type": "string"}, "actor": {"type": "string"}, "reason": {"type": "string", "minLength": 5},
          "previousHash": {"type": ["string", "null"]}, "snapshot": {"type": "object"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
